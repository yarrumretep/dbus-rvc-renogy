# Optional runtime overrides. Copy this file to
# /data/dbus-rvc-renogy/config and uncomment only values verified for the
# target Renogy REGO installation.

# export RVC_RENOGY_CAN_INTERFACE=can0
# Automatic discovery survives the REGO bank moving its aggregate role to a
# different source address after reboot. Set a hexadecimal address only for
# controlled diagnostics. Both 0x8D and bare hexadecimal 8D are accepted.
# export RVC_RENOGY_SOURCE_ADDRESS=auto
# Let Venus allocate a persistent, collision-free battery instance (preferred).
# Set a number only for controlled recovery; a forced number may collide.
# export RVC_RENOGY_DEVICE_INSTANCE=auto
# export RVC_RENOGY_CVL_CEILING=14.6
# export RVC_RENOGY_CCL_CEILING=300.0
